⍝ assert: assertNumbers(a: Long, b: Long, c: Long, value: APLValue)
⍝ assert: assertDimension(dimensionsOfSize(3), value)
⍝ assert: assertSimpleNumber(a, value.valueAt(0))
⍝ assert: assertSimpleNumber(b, value.valueAt(1))
⍝ assert: assertSimpleNumber(c, value.valueAt(2))
⍝ assert: assertNumbers(0, 0, 0, result.valueAt(0))
⍝ assert: assertNumbers(0, 0, 1, result.valueAt(1))
⍝ assert: assertNumbers(0, 1, 0, result.valueAt(2))
⍝ assert: assertNumbers(0, 1, 1, result.valueAt(3))
⍝ assert: assertNumbers(0, 2, 0, result.valueAt(4))
⍝ assert: assertNumbers(0, 2, 1, result.valueAt(5))
⍝ assert: assertNumbers(1, 0, 0, result.valueAt(6))
⍝ assert: assertNumbers(1, 0, 1, result.valueAt(7))
⍝ assert: assertNumbers(1, 1, 0, result.valueAt(8))
⍝ assert: assertNumbers(1, 1, 1, result.valueAt(9))
⍝ assert: assertNumbers(1, 2, 0, result.valueAt(10))
⍝ assert: assertNumbers(1, 2, 1, result.valueAt(11))
⍳ 2 3 2
