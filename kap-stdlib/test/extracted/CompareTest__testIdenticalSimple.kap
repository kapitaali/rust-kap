⍝ assert: assertSimpleNumber(1, parseAPLExpression("10≡10"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("10≡100"))
⍝ assert: assertSimpleNumber(1, parseAPLExpression("10 11≡10 11"))
⍝ assert: assertSimpleNumber(1, parseAPLExpression("11 12 13 14 15 16 17≡10+1 2 3 4 5 6 7"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("1 2 3≡1 2"))
⍝ assert: assertSimpleNumber(1, parseAPLExpression("(1 2) (3 4 (5 6)) ≡ (1 2) (3 4 (5 6))"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("(1 2) (3 4 (5 6)) ≡ (1 2) (3 4 (@a 6))"))
⍝ assert: assertSimpleNumber(1, parseAPLExpression("@a ≡ @a"))
⍝ assert: assertSimpleNumber(1, parseAPLExpression("1.2 ≡ 1.2"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("2J4 ≡ 2J3"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("(2⋆1000) ≡ 2.0"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("2.0 ≡ (2⋆1000)"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("(2⋆1000) ≡ 2j5"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("2j5 ≡ (2⋆1000)"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("(2⋆600) ≡ (2⋆1000)"))
⍝ assert: assertSimpleNumber(1, parseAPLExpression("(2⋆1000) ≡ (2⋆1000)"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("(2⋆1000) ≡ (÷10)"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("(÷10) ≡ (2⋆1000)"))
10≡10
