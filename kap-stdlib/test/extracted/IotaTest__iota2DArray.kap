⍝ assert: assertNumbers(a: Long, b: Long, value: APLValue)
⍝ assert: assertDimension(dimensionsOfSize(2), value)
⍝ assert: assertSimpleNumber(a, value.valueAt(0))
⍝ assert: assertSimpleNumber(b, value.valueAt(1))
⍝ assert: assertDimension(dimensionsOfSize(4, 5), result)
⍝ assert: assertNumbers(0, 0, result.valueAt(0))
⍝ assert: assertNumbers(0, 1, result.valueAt(1))
⍝ assert: assertNumbers(0, 2, result.valueAt(2))
⍝ assert: assertNumbers(0, 3, result.valueAt(3))
⍝ assert: assertNumbers(0, 4, result.valueAt(4))
⍝ assert: assertNumbers(1, 0, result.valueAt(5))
⍝ assert: assertNumbers(1, 1, result.valueAt(6))
⍝ assert: assertNumbers(1, 2, result.valueAt(7))
⍝ assert: assertNumbers(1, 3, result.valueAt(8))
⍝ assert: assertNumbers(1, 4, result.valueAt(9))
⍝ assert: assertNumbers(2, 0, result.valueAt(10))
⍝ assert: assertNumbers(2, 1, result.valueAt(11))
⍝ assert: assertNumbers(2, 2, result.valueAt(12))
⍝ assert: assertNumbers(2, 3, result.valueAt(13))
⍝ assert: assertNumbers(2, 4, result.valueAt(14))
⍝ assert: assertNumbers(3, 0, result.valueAt(15))
⍝ assert: assertNumbers(3, 1, result.valueAt(16))
⍝ assert: assertNumbers(3, 2, result.valueAt(17))
⍝ assert: assertNumbers(3, 3, result.valueAt(18))
⍝ assert: assertNumbers(3, 4, result.valueAt(19))
⍳ 4 5
