⍝ assert: assertDimension(dimensionsOfSize(2, 2, 3), result)
⍝ assert: assertArrayContent(arrayOf(3, 6, 2, 11, 0, 1, 7, 5, 4, 9, 10, 8), result)
⍝ assert: assertLabels(
                listOf(
                    listOf("g", "f"),
                    listOf("d", "e"),
                    listOf("a", "b", "c")),
                result)
⍝ assert: assertDimension(dimensionsOfSize(2, 2, 3), result)
⍝ assert: assertArrayContent(arrayOf(7, 5, 4, 9, 10, 8, 3, 6, 2, 11, 0, 1), result)
⍝ assert: assertLabels(
                listOf(
                    listOf("f", "g"),
                    listOf("d", "e"),
                    listOf("a", "b", "c")),
                result)
∧ "f" "g" labels[0] "d" "e" labels[1] "a" "b" "c" labels[2] 2 2 3 ⍴ 7 5 4 9 10 8 3 6 2 11 0 1
