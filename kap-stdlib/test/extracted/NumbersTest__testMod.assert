assertSimpleNumber(-1, parseAPLExpression("¯2|11"))
assertSimpleNumber(0, parseAPLExpression("3|3"))
assertSimpleNumber(2, parseAPLExpression("100|2"))
assertSimpleNumber(9995, parseAPLExpression("10000|¯20005"))
