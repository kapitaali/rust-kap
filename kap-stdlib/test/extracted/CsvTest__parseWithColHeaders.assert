assertDimension(dimensionsOfSize(4, 3), result)
assertArrayContent(
                arrayOf(
                    "b", "1", "2",
                    "c", "q", "w",
                    "d", "100", "aa",
                    "e", "1.5", "2.5"),
                result)
assertLabels(listOf(null, listOf("a", "foo", "abc")), result)
