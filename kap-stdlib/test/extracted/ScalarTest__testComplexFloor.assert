assertSimpleDouble(5.0, parseAPLExpression("math:floorc 5.9"))
assertSimpleDouble(-6.0, parseAPLExpression("math:floorc ¯5.1"))
assertBigIntOrLong("8", parseAPLExpression("math:floorc 50÷6"))
assertBigIntOrLong("-17", parseAPLExpression("math:floorc ¯50÷3"))
assertSimpleNumber(3, parseAPLExpression("math:floorc 3"))
assertSimpleComplex(Complex(1.0, 4.0), parseAPLExpression("math:floorc 1.1J3.9"))
assertSimpleComplex(Complex(2.0, 3.0), parseAPLExpression("math:floorc 1.9J3.9"))
assertSimpleComplex(Complex(-2.0, -7.0), parseAPLExpression("math:floorc ¯1.3J¯7.0"))
assertSimpleComplex(Complex(-4.0, -6.0), parseAPLExpression("math:floorc -4.1J5.2"))
assertSimpleComplex(Complex(1.0, 9.0), parseAPLExpression("math:floorc 1.01J9.9"))
