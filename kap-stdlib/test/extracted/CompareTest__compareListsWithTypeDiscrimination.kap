⍝ assert: assertSimpleNumber(0, parseAPLExpression("(1 ; 0.5) ≡ (1 ; 1÷2)"))
⍝ assert: assertSimpleNumber(1, parseAPLExpression("(1 ; 0.5) ≢ (1 ; 1÷2)"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("(2 ; 0.5) ≡ (1 ; 1÷2)"))
⍝ assert: assertSimpleNumber(1, parseAPLExpression("(2 ; 0.5) ≢ (1 ; 1÷2)"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("(1 ; 0.49999) ≡ (1 ; 1÷2)"))
⍝ assert: assertSimpleNumber(1, parseAPLExpression("(1 ; 0.49999) ≢ (1 ; 1÷2)"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("(1 ; ¯0.0) ≡ (1 ; 0.0)"))
⍝ assert: assertSimpleNumber(1, parseAPLExpression("(1 ; ¯0.0) ≢ (1 ; 0.0)"))
⍝ assert: assertSimpleNumber(0, parseAPLExpression("(2 ; ¯0.0) ≡ (1 ; 0.0)"))
⍝ assert: assertSimpleNumber(1, parseAPLExpression("(2 ; ¯0.0) ≢ (1 ; 0.0)"))
(1 ; 0.5) ≡ (1 ; 1÷2)
