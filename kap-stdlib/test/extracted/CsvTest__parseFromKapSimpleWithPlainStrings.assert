assertDimension(dimensionsOfSize(5, 4), result)
assertArrayContent(
            arrayOf(
                "foo", "bar", "1234", "12.25",
                "11", "xyz", "a", "b",
                "a", "", "b", "c",
                "abc", "  def ", "11", "11.5",
                "123456789012345678901234567890", "-2", "-1.5", "-1234567890123456789012345678900000"),
            result)
