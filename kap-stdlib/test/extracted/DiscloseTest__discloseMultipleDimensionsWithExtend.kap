⍝ assert: assertDimension(dimensionsOfSize(5, 2, 4), result)
⍝ assert: assertArrayContent(
                arrayOf(
                    1, 2, 3, 0,
                    0, 0, 0, 0,
                    1, 2, 3, 4,
                    0, 0, 0, 0,
                    0, 1, 0, 0,
                    2, 3, 0, 0,
                    9, 8, 7, 6,
                    0, 0, 0, 0,
                    1, 0, 0, 0,
                    2, 0, 0, 0),
                result)
⊃ (1 2 3) (1 2 3 4) (2 2 ⍴ 0 1 2 3) (9 8 7 6) (2 1 ⍴ 1 2)
