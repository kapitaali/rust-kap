assertDimension(dimensionsOfSize(3, 3), result)
assertArrayContent(
                arrayOf(
                    Inner1D(arrayOf(1, 1)),
                    Inner1D(arrayOf(1, 2)),
                    Inner1D(arrayOf(1, 3)),
                    Inner1D(arrayOf(2, 0)),
                    Inner1D(arrayOf(2, 1)),
                    Inner1D(arrayOf(2, 2)),
                    Inner1D(arrayOf(2, 3)),
                    Inner1D(arrayOf(3, 0)),
                    Inner1D(arrayOf(3, 1))),
                result)
