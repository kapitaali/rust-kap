⍝ assert: assertDimension(dimensionsOfSize(4, 3, 3), result)
⍝ assert: assertArrayContent(
                arrayOf(
                    1, 2, 0, 3, 4, 0, 0, 0, 0, 10, 11, 12, 13, 14, 15, 0, 0, 0,
                    200, 201, 0, 200, 201, 0, 0, 0, 0, 30, 31, 32,
                    33, 34, 35, 36, 37, 38), result)
⊃ (2 2 ⍴ 1 2 3 4) (2 3 ⍴ 10 11 12 13 14 15) (2 2 ⍴ 200 201) (3 3 ⍴ 30 31 32 33 34 35 36 37 38)
