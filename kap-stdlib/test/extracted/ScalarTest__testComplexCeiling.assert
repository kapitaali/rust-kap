assertSimpleDouble(2.0, parseAPLExpression("math:ceilc 1.4"))
assertSimpleDouble(3.0, parseAPLExpression("math:ceilc 2.9"))
assertSimpleDouble(-3.0, parseAPLExpression("math:ceilc ¯3.1"))
assertSimpleNumber(9, parseAPLExpression("math:ceilc 9"))
assertBigIntOrLong("9", parseAPLExpression("⌈50÷6"))
assertSimpleComplex(Complex(4.0, 6.0), parseAPLExpression("math:ceilc 4.1J5.2"))
assertSimpleComplex(Complex(91.0, 2.0), parseAPLExpression("math:ceilc 90.8J1.9"))
assertSimpleComplex(Complex(-1.0, -5.0), parseAPLExpression("math:ceilc ¯1.8J¯4.82"))
assertSimpleComplex(Complex(-10.0, -40.0), parseAPLExpression("math:ceilc ¯10.1J¯40.1"))
