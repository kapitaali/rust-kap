assertSimpleNumber(0, parseAPLExpression("1÷0"))
assertSimpleNumber(0, parseAPLExpression("100÷0"))
assertSimpleNumber(0, parseAPLExpression("¯100÷0"))
assertSimpleDouble(Double.POSITIVE_INFINITY, parseAPLExpression("12.2÷0"))
assertSimpleDouble(Double.POSITIVE_INFINITY, parseAPLExpression("2÷0.0"))
