⍝ assert: assertIs(result)
⍝ assert: assertEquals(2, result.elementCount())
⍝ assert: assertString("a", result.lookupValue(APLString.make("foo").makeTypeQualifiedKey())!!)
⍝ assert: assertString("b", result.lookupValue(APLString.make("bar").makeTypeQualifiedKey())!!)
